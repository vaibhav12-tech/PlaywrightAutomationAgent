# Copy values into your CI secrets / local env (do not commit real secrets).

# Optional base URL (default https://www.saucedemo.com)
SAUCE_BASE_URL=https://www.saucedemo.com

# Role credentials (defaults are SauceDemo demo users)
SAUCE_ADMIN_USER=standard_user
SAUCE_ADMIN_PASSWORD=secret_sauce

SAUCE_MANAGER_USER=problem_user
SAUCE_MANAGER_PASSWORD=secret_sauce

SAUCE_AGENT_USER=performance_glitch_user
SAUCE_AGENT_PASSWORD=secret_sauce

SAUCE_READONLY_USER=visual_user
SAUCE_READONLY_PASSWORD=secret_sauce

# Comma-separated roles for global-setup (default: all)
# SAUCE_SESSION_ROLES=Admin,Manager

# Session time-to-live in ms (default 4 hours)
# SAUCE_SESSION_TTL_MS=14400000

# Skip multi-user global setup for OCE-only pipelines
# SKIP_MULTI_USER_SESSION_SETUP=true
