{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "playwright"]
  },
  "include": [
    "src",
    "pages",
    "utils",
    "reporters",
    "scripts",
    "features",
    "playwright.config.ts",
    "tests"
  ]
}
